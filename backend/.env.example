# Copy to `.env` (used by docker compose and local runs).

# --- App ---
APP_ENV=dev
LOG_LEVEL=INFO
# console (pretty dev output) | json (structured, used in Docker)
LOG_FORMAT=console

# --- Database ---
# docker compose provisions Postgres with these; the API connects via the
# compose-internal hostname `postgres`. For local (non-Docker) runs against
# the published port, use: postgresql+psycopg://desk:desk@localhost:5443/desk
POSTGRES_USER=desk
POSTGRES_PASSWORD=desk
POSTGRES_DB=desk
DATABASE_URL=postgresql+psycopg://desk:desk@postgres:5432/desk

# --- Auth ---
# Change JWT_SECRET for anything beyond local development; the API refuses
# to boot in APP_ENV=prod with the default secret.
JWT_SECRET=dev-only-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
