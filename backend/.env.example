# --- App ---
APP_ENV=dev
LOG_LEVEL=INFO

# --- Database ---
#docker-compose uses these to provision Postgres; the API uses DATABASE_URL.
POSTGRES_USER=desk
POSTGRES_PASSWORD=desk
POSTGRES_DB=desk
DATABASE_URL=postgresql+psycopg://desk:desk@postgres:5432/desk
# Local (non-Docker) example: postgresql+psycopg://desk:desk@localhost:5433/desk

# --- Auth ---
JWT_SECRET=dev-only-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
